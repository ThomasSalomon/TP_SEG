# Perfil de seguridad: vulnerable, segura, solo_filtros, solo_v1 … solo_v5.
# Es obligatorio: sin esta variable la aplicación no arranca.
SECURITY_PROFILE=vulnerable

# Servidor de Ollama. Dentro de Compose es el servicio `ollama` de la red interna.
OLLAMA_BASE_URL=http://ollama:11434

# Parámetros del modelo. Valores provisorios hasta cerrar la tarea 2 (docs/decisiones/modelo.md).
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.7
LLM_BASE_SEED=1000
LLM_NUM_PREDICT=512
LLM_NUM_CTX=4096
LLM_TIMEOUT_S=120

# Base de pedidos y colección de Chroma de este servicio.
DATA_DIR=/data
